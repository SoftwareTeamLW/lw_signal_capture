<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1480</width><height>900</height></rect>
  </property>
  <property name="minimumSize"><size><width>860</width><height>500</height></size></property>
  <property name="windowTitle"><string>LW39X0 Signal Capture</string></property>
  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralWidget {
    background:#303B40;
    color:#E7ECEE;
    font:10pt "Microsoft YaHei UI","Noto Sans CJK SC",sans-serif;
}
QFrame#topBar {
    background:#39464C;
    border:1px solid #66757B;
    border-radius:7px;
}
QLabel#appTitleLabel {
    color:#F5F7F7;
    font-size:16px;
    font-weight:700;
}
QLabel#appSubTitleLabel { color:#AEBBC0; font-size:11px; }
QLabel#driverBadgeLabel {
    background:#43565E;
    border:1px solid #7F969F;
    border-radius:10px;
    color:#E2EAED;
    padding:3px 10px;
    font-weight:700;
}
QWidget#leftPanel, QWidget#rightPanel { background:#303B40; }
QGroupBox {
    background:#3B484E;
    border:1px solid #64747A;
    border-radius:7px;
    margin-top:14px;
    padding-top:10px;
    font-weight:600;
}
QGroupBox::title {
    subcontrol-origin:margin;
    subcontrol-position:top left;
    left:10px;
    padding:0 6px;
    color:#F0F3F4;
    background:#303B40;
}
QLabel { color:#DDE4E6; }
QLabel#connectionStatusValueLabel,
QLabel#statusValueLabel,
QLabel#captureStatusInfoValueLabel { font-weight:700; }
QLineEdit, QSpinBox, QDoubleSpinBox {
    background:#313D42;
    border:1px solid #687A80;
    border-radius:5px;
    min-height:28px;
    padding:1px 7px;
    color:#F0F4F5;
    selection-background-color:#647D87;
    selection-color:#FFFFFF;
}
QComboBox {
    background:#3A474D;
    border:1px solid #718188;
    border-radius:5px;
    min-height:28px;
    padding:1px 7px;
    color:#F0F4F5;
    selection-background-color:#60757D;
    selection-color:#FFFFFF;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border:1px solid #9AB0B8;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color:#88969B;
    background:#313B3F;
    border-color:#4F5D62;
}
QComboBox::drop-down {
    subcontrol-origin:padding;
    subcontrol-position:top right;
    width:26px;
    background:#435159;
    border-left:1px solid #687A80;
    border-top-right-radius:5px;
    border-bottom-right-radius:5px;
}
QComboBox QAbstractItemView {
    background:#3A474D;
    color:#F0F4F5;
    border:1px solid #708289;
    outline:0;
    selection-background-color:#596D75;
    selection-color:#FFFFFF;
}
QComboBox QAbstractItemView::item:disabled {
    color:#748287;
    background:#354045;
}
QPushButton {
    background:#46545A;
    border:1px solid #718288;
    border-radius:5px;
    min-height:30px;
    padding:3px 10px;
    color:#F0F3F4;
}
QPushButton:hover { background:#53636A; border-color:#91A3AA; }
QPushButton:pressed { background:#39464B; }
QPushButton:disabled { color:#879499; background:#343E42; border-color:#505E63; }
QPushButton#connectDeviceButton { background:#4B626C; border-color:#7E99A3; font-weight:700; }
QPushButton#connectDeviceButton:hover { background:#58737E; border-color:#9AB4BD; }
QPushButton#disconnectDeviceButton { background:#414E53; }
QPushButton#startButton { background:#28704F; border:2px solid #4A9A72; min-height:34px; font-weight:700; }
QPushButton#startButton:hover { background:#31845E; border-color:#65B68B; }
QPushButton#stopButton { background:#7B4246; border:2px solid #A7666B; min-height:34px; font-weight:700; }
QPushButton#stopButton:hover { background:#915056; border-color:#C17A80; }
QCheckBox { color:#E1E6E8; spacing:7px; }
QCheckBox::indicator {
    width:16px;
    height:16px;
    background:#3A474D;
    border:1px solid #718188;
    border-radius:3px;
}
QCheckBox::indicator:hover { border-color:#9AB0B8; background:#435159; }
QCheckBox::indicator:checked {
    background:#6F858E;
    border:2px solid #B5C4C9;
    image:url(:/ui/check_mark.png);
}
QCheckBox::indicator:disabled { background:#343E42; border-color:#505E63; }
QCheckBox::indicator:checked:disabled {
    background:#53636A;
    border:2px solid #879BA3;
    image:url(:/ui/check_mark.png);
}
QPlainTextEdit {
    background:#20282B;
    color:#C9E3D1;
    border:1px solid #59686E;
    border-radius:5px;
    font:9pt "DejaVu Sans Mono","Consolas",monospace;
    padding:4px;
}
QTabWidget::pane { border:1px solid #5E6E74; background:#252E32; border-radius:4px; }
QTabBar::tab { background:#3C494F; color:#D2DADD; padding:8px 22px; border:1px solid #5E6E74; }
QTabBar::tab:selected { background:#53656D; color:#FFFFFF; border-bottom:2px solid #9CB0B7; }
QSplitter::handle { background:#536167; }
QStatusBar { background:#39454A; color:#E5E9EA; border-top:1px solid #627178; }
QStatusBar::item { border:0px; }
QStatusBar QLabel { padding:0px 10px; color:#C2CCCF; }
QFrame#spectrumToolFrame {
    background:#354147;
    border:1px solid #607177;
    border-radius:5px;
}
QFrame#spectrumToolFrame QLabel { color:#C2CDD0; font-size:9pt; }
QFrame#spectrumToolFrame QPushButton {
    min-height:26px;
    padding:1px 8px;
    background:#435159;
    border:1px solid #6A7C83;
}
QFrame#spectrumToolFrame QPushButton:checked {
    background:#60737B;
    border-color:#9EB2BA;
    color:#FFFFFF;
    font-weight:700;
}
QPushButton#maxHoldButton:checked {
    background:#655238;
    border-color:#C99D58;
    color:#F0D3A4;
}
QPushButton#minHoldButton:checked {
    background:#5A485F;
    border-color:#AA83B2;
    color:#E1CBE5;
}
QPushButton#markerEnableButton:checked {
    background:#395F50;
    border-color:#70A58D;
    color:#D1E8DE;
}
QFrame#spectrumToolFrame QPushButton#clearHoldButton,
QFrame#spectrumToolFrame QPushButton#screenshotButton { min-width:64px; }
QFrame#spectrumToolFrame QDoubleSpinBox {
    min-height:26px;
    max-width:96px;
    padding:0px 5px;
}
QFrame#spectrumToolFrame QComboBox {
    min-height:26px;
    padding:0px 6px;
}
QLabel#markerHintLabel { color:#99A8AD; font-size:8pt; }
QToolTip { background:#2D383C; color:#F0F4F5; border:1px solid #708289; }
